<?xml version="1.0" encoding="utf-8"?>
<resources>
        <style name="Angerona" />
    <style name="Theme.Angerona" parent="android:Theme.Material.NoActionBar">
        <item name="android:colorPrimary">@color/bar</item>
        <item name="android:colorPrimaryDark">@color/strip</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:colorBackground">@color/page</item>
        <item name="android:windowBackground">@color/page</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:textColorPrimary">@color/text</item>
        <item name="android:textColorSecondary">@color/muted</item>
        <item name="android:textColorHint">@color/muted</item>
        <item name="android:colorControlNormal">@color/muted</item>
        <item name="android:colorControlActivated">@color/accent</item>
        <item name="android:alertDialogTheme">@style/Theme.Angerona.Dialog</item>
        <item name="android:datePickerDialogTheme">@style/Theme.Angerona.Dialog</item>
        <item name="android:timePickerDialogTheme">@style/Theme.Angerona.Dialog</item>
        <item name="android:popupMenuStyle">@style/Angerona.PopupMenu</item>
    </style>

    <style name="Theme.Angerona.Dialog" parent="android:Theme.Material.Dialog.Alert">
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:colorBackground">@color/bar</item>
        <item name="android:textColorPrimary">@color/text</item>
        <item name="android:textColorSecondary">@color/text2</item>
    </style>

    <style name="Angerona.PopupMenu" parent="android:Widget.Material.PopupMenu">
        <item name="android:popupBackground">@drawable/bg_popup</item>
    </style>

    <style name="Angerona.IconButton">
        <item name="android:layout_width">44dp</item>
        <item name="android:layout_height">44dp</item>
        <item name="android:padding">10dp</item>
        <item name="android:background">@drawable/bg_ripple_round</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="android:tint">@color/text2</item>
    </style>

    <style name="Angerona.Section">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">vertical</item>
        <item name="android:background">@drawable/bg_card</item>
        <item name="android:padding">16dp</item>
        <item name="android:layout_marginBottom">12dp</item>
    </style>

    <style name="Angerona.SectionTitle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:layout_marginBottom">4dp</item>
    </style>

    <style name="Angerona.Help">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/muted</item>
        <item name="android:textSize">13sp</item>
        <item name="android:layout_marginBottom">10dp</item>
    </style>

    <style name="Angerona.Label">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/text2</item>
        <item name="android:textSize">12sp</item>
        <item name="android:layout_marginTop">6dp</item>
    </style>

    <style name="Angerona.Input">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:background">@drawable/bg_input</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:textColorHint">@color/muted</item>
        <item name="android:textSize">15sp</item>
        <item name="android:singleLine">true</item>
        <item name="android:layout_marginTop">4dp</item>
    </style>

    <style name="Angerona.Switch">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:textSize">15sp</item>
        <item name="android:thumbTint">@color/text2</item>
        <item name="android:trackTint">@color/accent_strong</item>
    </style>

    <style name="Angerona.Button">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">44dp</item>
        <item name="android:background">@drawable/bg_button_ghost</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>
</resources>
